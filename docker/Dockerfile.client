# rscross 节点/客户端镜像
FROM rust:1.82-bookworm AS builder
WORKDIR /build

COPY . .
RUN cargo build --release -p rscross-client \
    && strip target/release/rscross-client || true

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/rscross-client /app/rscross-client

ENTRYPOINT ["/app/rscross-client"]
