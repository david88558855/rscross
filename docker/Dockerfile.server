# rscross 服务端镜像
FROM rust:1.82-bookworm AS builder
WORKDIR /build

# 依赖层缓存
COPY Cargo.toml Cargo.lock ./
COPY crates/rscross-common/Cargo.toml crates/rscross-common/
COPY crates/rscross-frp/Cargo.toml crates/rscross-frp/
COPY crates/rscross-server/Cargo.toml crates/rscross-server/
COPY crates/rscross-client/Cargo.toml crates/rscross-client/
RUN mkdir -p crates/rscross-common/src crates/rscross-frp/src \
             crates/rscross-server/src crates/rscross-client/src \
    && echo "fn main(){}" > crates/rscross-common/src/lib.rs \
    && echo "fn main(){}" > crates/rscross-frp/src/lib.rs \
    && echo "fn main(){}" > crates/rscross-server/src/main.rs \
    && echo "fn main(){}" > crates/rscross-client/src/main.rs \
    && cargo build --release -p rscross-server || true

# 真实源码
COPY . .
# 确保 assets 目录存在（include_dir 要求编译期存在）
RUN mkdir -p crates/rscross-server/assets \
    && touch crates/rscross-server/assets/index.html
RUN cargo build --release -p rscross-server \
    && strip target/release/rscross-server || true

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/rscross-server /app/rscross-server
RUN mkdir -p /app/data /app/logs

EXPOSE 8080
VOLUME ["/app/data", "/app/logs"]

ENTRYPOINT ["/app/rscross-server"]
CMD ["--log-level", "info"]
